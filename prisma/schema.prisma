// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") // should be defined in .env file
}

model Post {
  id      Int     @id @default(autoincrement())
  title   String
  content String?
  createdAt DateTime @default(now())
}
